# re-memory configuration
# Copy to ~/.re-memory/config.toml or ./re_memory.toml

[llm]
provider = "ollama"          # ollama, openai, anthropic, deepseek
model = "llama3.2"
base_url = "http://localhost:11434"
api_key = ""                 # required for openai/anthropic/deepseek

[embedding]
provider = "ollama"          # ollama, openai, anthropic
model = "nomic-embed-text"
base_url = "http://localhost:11434"
dimensions = 768
api_key = ""

[storage]
qdrant_url = "http://localhost:6333"
falkordb_host = "localhost"
falkordb_port = 6379
sqlite_path = "~/.re-memory/events.db"
schema_dir = "~/.re-memory/schemas"

[consolidation]
interval_hours = 24          # how often the daemon runs
decay_rate = 0.1             # Ebbinghaus decay factor
confidence_threshold = 0.3   # below this, memories get pruned
max_episodic_age_days = 30   # max age before forced consolidation

[memory]
working_memory_slots = 7     # theta-gamma capacity (~7 items)
max_retrieval_tokens = 2000  # token budget for recall responses
novelty_threshold = 0.3      # CA1 prediction error threshold
importance_threshold = 0.5   # amygdala salience gate
